;----------- Retract Spindle, Stop Spindle and Stop Coolant
	(debug,Z RETRACT)
	G1 F8000 G53 Z-10
	G04 P0.1
	(debug,Z DONE) 
	M5 										;stop spindle
	(debug,SPINDLE STOPPED)
	M9 										;stop coolant/mist
	(debug,COOLANT STOPPED)
;	(debug, #900)
;	(debug, #901)
;----------- Check Validity of Current and Next Tool Number to prevent accidentally storing hand loaded tools
	(debug, checking tool number validity)
;	(debug, #900)
;	(debug, #901)
	O101 if [#<_current_tool> GT 4]					;if tool number is incorrectly higher than 4, kill the macro 
		(abort, Killing Macro because Current Tool Number Greater than 4 - Invalid)
		
	O101 elseif [#<_current_tool> LT 1]				;if tool number is less than 1, kill the macro
		(abort, Killing Macro because Current Tool Number Less than 1 - Invalid)
		
	O101 endif
	O102 if [#<_selected_tool> GT 4]				;if tool number is incorrectly higher than 4, kill the macro
		(abort, Killing Macro because Selected Tool Number Greater than 4 - Invalid)
		
	O102 elseif [#<_selected_tool> LT 1]				;if tool number is less than 1, kill the macro
		(abort, Killing Macro because Selected Tool Number Less than 1 - Invalid)

	O102 endif

;----------- Open ATC Door
	M64 p1
	G04 P1 ;wait 1 second for atc door to be in position
	;Input 0 = Door Open
	;Input 1 = Tool In Pocket
	;Input 2 = Door Closed

;	(debug, #900)
;	(debug, #901)	
;----------- Modbus Read - Door Open? -----------	
	G65P7 S3 F2 R0 							;read DI0 on Slave 3 and also test modbus is working. If neither succeed fail the macro and fault the machine
		#900=#<_value_returned>
		#901=#<_value>
;	(debug, #900)
;	(debug, #901)
	(debug, Checking If ATC Door Opened)
;----------- Faulty Value Detection -----------	
	O122 if [#901 GT 1] 						;If door failed to open fault macro
			(abort, Faulty Value Detected)
	O122 endif
	O123 if [#901 LT 0] 						;If door failed to open fault macro
			(abort, Faulty Value Detected)
	O123 endif
;----------- Modbus Result Processing -----------
	O120 if [#900 EQ 0] 						;If a modbus exception is received
			(abort, Modbus Read Failed)	
	O120 endif
	O121 if [#901 EQ 0] 						;If door failed to open fault macro
			(abort, ATC Door Failed To Open)
	O121 endif

;----------- move to x position ready for entry into atc area
	G1 G53 X-200 F10000
	G04 P0.1

;----------- disable keepout protection(Scienci)
	m960p0
	G04 P0.1
	(debug,In Position to start toolchange)


;----------- move to x position ready for entry into tool swap
	G1 G53 X-80 F4000
	G04 P0.1	

;----------- select what tool position to rotate to based on current tool number
	O130 if [#<_current_tool> EQ 1]
		G1 F5000 G53		B-1.8 					;rotate to appropriate pocket
	O130 elseif [#<_current_tool> EQ 2]
		G1 F5000 G53		B-16.2 					;rotate to appropriate pocket
	O130 elseif [#<_current_tool> EQ 3]
		G1 F5000 G53		B-30.6 					;rotate to appropriate pocket
	O130 elseif [#<_current_tool> EQ 4]
		G1 F5000 G53		B-45 					;rotate to appropriate pocket
	O130 endif

	G04 P1								;dwell for 0.1s to force machine to read only when actually in position
;----------- Modbus Read - Tool in Pocket? -----------
	G65P7 S3 F2 R1 								;read DI1 on Slave 3 and also test modbus is working. If neither succeed fail the macro and fault the machine
		#950=#<_value_returned>
		#951=#<_value>
	(debug, Checking If Tool In Pocket)
;----------- Faulty Value Detection -----------	
	O142 if [#951 GT 1] 						;If door failed to open fault macro
			(abort, Faulty Value Detected)
	O142 endif
	O143 if [#951 LT 0] 						;If door failed to open fault macro
			(abort, Faulty Value Detected)
	O143 endif
;----------- Modbus Result Processing -----------
	O140 if [#950 EQ 0] 							;If a modbus exception is received
		(abort, Modbus Read Failed)
	O140 endif
	O141 if [#951 EQ 1] 							;If tool is in pocket fail macro
			(abort, Pocket Occupied)
	O141 endif
;----------- Drop Tool Off at correct Z Height TODO - Double check tool entry height for each pocket, Individual to allow to tweaking of each pocket
	O150 if [#<_current_tool> EQ 1]
		G1 F4000 G53		Z-119.300				;move to tool rack entry height
		G1 F2000 G53 		X-4.7					;enter pocket
	O150 elseif [#<_current_tool> EQ 2]
		G1 F4000 G53		Z-119.300				;move to tool rack entry height
		G1 F2000 G53 		X-4.7					;enter pocket
	O150 elseif [#<_current_tool> EQ 3]
		G1 F4000 G53		Z-119.300				;move to tool rack entry height
		G1 F2000 G53 		X-4.7					;enter pocket
	O150 elseif [#<_current_tool> EQ 4]
		G1 F4000 G53		Z-119.300				;move to tool rack entry height
		G1 F2000 G53 		X-4.7					;enter pocket
	O150 endif

	G04 P0.1 
;----------- Open Spindle
	M64 P3 											;release current tool
	G04 P1 											;pause for 1 second so that pneumatics come to final stroke position
;----------- Modbus Read - Spindle Opened? -----------
	G65P7 S4 F2 R0 									;Placeholder for reading if Spindle Opened
		#904=#<_value_returned>
		#905=#<_value>
	(debug, Checking If Tool In Spindle)
;----------- Faulty Value Detection -----------
	O162 if [#905 GT 1] 							;If door failed to open fault macro
			(abort, Faulty Value Detected)
	O162 endif
	O163 if [#905 LT 0] 							;If door failed to open fault macro
			(abort, Faulty Value Detected)
	O163 endif
;----------- Modbus Result Processing -----------
	O160 if [#904 EQ 0] 							;If a modbus exception is received
		(abort, Modbus Read Failed)
	O160 endif
	O161 if [#905 EQ 1] 							;If Spindle failed to open fault macro 
		(abort, Spindle Didn't Release)
	O161 endif
;----------- Retract Spindle from Pocket
	;(debug,Retracting)
	G91 											;set to Incremental Mode  
	G1 F4000 Z60									;z axis up after tool release
	G90	 											;set to Absolute Mode
;----------- Modbus Read - Tool in Spindle?-----------
	G65P7 S4 F2 R1 									;Reading if Tool Still in Spindle
		#906=#<_value_returned>
		#907=#<_value>
	(debug, Checking If Tool In Spindle)
;----------- Faulty Value Detection -----------
	O172 if [#907 GT 1] 							;If door failed to open fault macro
			(abort, Faulty Value Detected)
	O172 endif
	O173 if [#907 LT 0] 							;If door failed to open fault macro
			(abort, Faulty Value Detected)
	O173 endif
;----------- Modbus Result Processing -----------
	O170 if [#906 EQ 0] 							;If a modbus exception is received
		(abort, Modbus Read Failed)
	O170 endif
	O171 if [#907 EQ 1] 							;If Tool is still in spindle, kill the macro
			(abort, Tool Still In Spindle)
	O171 endif
;----------- select what tool position to rotate to based on current tool number
	O180 if [#<_selected_tool> EQ 1]
		G1 F5000 G53		B-1.8 					;rotate to appropriate pocket
	O180 elseif [#<_selected_tool> EQ 2]
		G1 F5000 G53		B-16.2 					;rotate to appropriate pocket
	O180 elseif [#<_selected_tool> EQ 3]
		G1 F5000 G53		B-30.6 					;rotate to appropriate pocket
	O180 elseif [#<_selected_tool> EQ 4]
		G1 F5000 G53		B-45 					;rotate to appropriate pocket
	O180 endif
	
	G04 P1
;----------- Modbus Read - Tool In Pocket?-----------
	G65P7 S3 F2 R1 									;read DI1 on Slave 3 and also test modbus is working. If neither succeed fail the macro and fault the machine
		#952=#<_value_returned>
		#953=#<_value>
	(debug, Checking If Tool In Pocket)
;----------- Faulty Value Detection -----------
	O192 if [#953 GT 1] 							;If door failed to open fault macro
			(abort, Faulty Value Detected)
	O192 endif
	O193 if [#953 LT 0] 							;If door failed to open fault macro
			(abort, Faulty Value Detected)
	O193 endif
;----------- Modbus Result Processing -----------
	O190 if [#952 EQ 0] 							;If a modbus exception is received
		(abort, Modbus Read Failed)
	O190 endif
	O191 if [#953 EQ 0] 							;If tool is in pocket fail macro
		(abort, Pocket Empty)
	O191 endif
;----------- Pickup tool at correct Z Height TODO - Double check tool entry height for each pocket, Individual to allow to tweaking of each pocket
	O200 if [#<_selected_tool> EQ 1]
		G1 F1000 G53		Z-119.300				;move to tool rack entry height
	O200 elseif [#<_selected_tool> EQ 2]
		G1 F1000 G53		Z-119.300				;move to tool rack entry height
	O200 elseif [#<_selected_tool> EQ 3]
		G1 F1000 G53		Z-119.300				;move to tool rack entry height
	O200 elseif [#<_selected_tool> EQ 4]
		G1 F1000 G53		Z-119.300				;move to tool rack entry height
	O200 endif
	
	G04 P0.1
;----------- Close Spindle
	M65 P3 											;Clamp current tool
	G04 P1 											;pause for 1 second so that pneumatics come to final stroke position
;----------- Modbus Read - Spindle Opened?-----------
	G65P7 S4 F2 R0 									;Placeholder for reading if Spindle Opened 
		#910=#<_value_returned>
		#911=#<_value>
	(debug, Checking If Tool In Spindle)
;----------- Faulty Value Detection -----------
	O212 if [#911 GT 1] 							;If door failed to open fault macro
			(abort, Faulty Value Detected)
	O212 endif
	O213 if [#911 LT 0] 							;If door failed to open fault macro
			(abort, Faulty Value Detected)
	O213 endif
;----------- Modbus Result Processing -----------
	O210 if [#910 EQ 0] 							;If a modbus exception is received
		(abort, Modbus Read Failed)
	O210 endif
	O211 if [#911 EQ 0] 							;If Spindle Failed to Close fault macro
		(abort, Spindle Didn't Close)
	O211 endif
;----------- update tool number
	M61Q#<_selected_tool>							;set desired tool to current tool
;----------- leave pocket
	G91 											;set to Incremental Mode
	G1 F3000 X-50
	G90												;set to Absolute Mode
;----------- Modbus Read - Tool in Spindle?-----------
	G65P7 S4 F2 R1 									;Placeholder for reading if Spindle Opened 
		#912=#<_value_returned>
		#913=#<_value>
	(debug, Checking If Tool In Pocket)
;----------- Faulty Value Detection -----------
	O222 if [#913 GT 1] 							;If door failed to open fault macro
			(abort, Faulty Value Detected)
	O222 endif
	O223 if [#913 LT 0] 							;If door failed to open fault macro
			(abort, Faulty Value Detected)
	O223 endif
;----------- Modbus Result Processing -----------
	O220 if [#912 EQ 0] 							;If a modbus exception is received
		(abort, Modbus Read Failed)
	O220 endif
	O221 if [#913 EQ 0] 							;If Spindle Failed to Close fault macro
			(abort, Tool Not in Spindle.)
	O221 endif
;----------- Retract Spindle,	
	G1 F1000 G53 Z-10
;----------- Move Spindle away from ATC Door to allow it to close -----------
	g1 f1000 g53 x-300
	g4 p0.1  									;dwell to ensure sender waits for move to complete before triggering atc door close

