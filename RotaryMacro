	O240 if [#103 EQ 1] 						; restore spindle status
		M3
	O240 endif

	O241 if [#105 EQ 1] 						; restore mist status
		M7
	O241 endif
	O242 if [#104 EQ 1] 						; restore coolant status
		M8
	O242 endif
